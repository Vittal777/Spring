pipeline {
    agent {
		docker{
			image 'maven-docker-agent'
			args '-u root -v /var/run/docker.sock:/var/run/docker.sock'
		}
	}

    stages {

        stage('Build') {
            steps {
				dir('LoginPage'){
                sh 'mvn --version'
                sh 'mvn clean package -DskipTests'
                }
            }
        }
        stage('Docker Image Build'){
			steps{
				sh 'docker build -t loginpage-springboot:${BUILD_NUMBER} LoginPage'
			}
		}
		stage('Push Docker Image'){
			steps{
				withCredentials([usernamePassword(
					credentialsId: 'docker_hub-credentials',
					usernameVariable: 'DOCKER_USER',
					passwordVariable: 'DOCKER_PASS'
				)]){
					
					sh '''
					echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
					
					docker tag loginpage-springboot:${BUILD_NUMBER} $DOCKER_USER/loginpage-springboot:${BUILD_NUMBER}
					docker tag loginpage-springboot:${BUILD_NUMBER} $DOCKER_USER/loginpage-springboot:latest
					
					docker push $DOCKER_USER/loginpage-springboot:${BUILD_NUMBER}
					docker push $DOCKER_USER/loginpage-springboot:latest
					
					docker logout
					'''
				}
			}
		}
    }
    post{
		success{
			archiveArtifacts artifacts: 'LoginPage/target/*-SNAPSHOT.jar', fingerprint: true
		}
	}
}